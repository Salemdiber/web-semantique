# Configuration Fuseki — dataset "education" avec raisonneur OWL.
#
# Ce fichier est lu automatiquement par fuseki-server (FUSEKI_BASE=/fuseki
# dans l'image Docker stain/jena-fuseki). Le service s'appelle "education"
# : les endpoints restent /education/query, /education/data, etc.
#
# Conforme au template officiel Fuseki 5.1 (org/apache/jena/fuseki/webapp/
# templates/config-tdb2) + pattern d'inférence ja:InfModel/OWLFBRuleReasoner.
#
# Graphe par défaut = InfModel (raisonneur OWL) au-dessus du stockage TDB2
# persistant /fuseki/databases/education.
# => les requêtes rdf:type exploitent l'inférence de sous-classes OWL
#    (ex: un individu de type Examen est aussi vu Evaluation,
#    Validation d'une Certification Technique vu Certification, ...)

@prefix :        <#> .
@prefix fuseki:  <http://jena.apache.org/fuseki#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tdb2:    <http://jena.apache.org/2016/tdb#> .
@prefix ja:      <http://jena.hpl.hp.com/2005/11/Assembler#> .

<#service_education> rdf:type fuseki:Service ;
    rdfs:label "Ontologie Education & Formation (raisonneur OWL)" ;
    fuseki:name "education" ;
    fuseki:dataset <#dataset_education> ;

    fuseki:endpoint [ fuseki:name "query"  ; fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:name "sparql" ; fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:name "update" ; fuseki:operation fuseki:update ] ;
    fuseki:endpoint [ fuseki:name "data"   ; fuseki:operation fuseki:gsp-rw ] ;
    fuseki:endpoint [ fuseki:name "get"    ; fuseki:operation fuseki:gsp-r ] ;
    .

<#dataset_education> rdf:type ja:RDFDataset ;
    ja:defaultGraph <#model_inf> .

<#model_inf> rdf:type ja:InfModel ;
    ja:baseModel <#model_tdb2> ;
    ja:reasoner [
        ja:reasonerURL <http://jena.hpl.hp.com/2003/OWLFBRuleReasoner>
    ] .

<#model_tdb2> rdf:type tdb2:GraphTDB2 ;
    tdb2:dataset <#dataset_tdb2> .

<#dataset_tdb2> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/education" .
