        <rdfs:comment xml:lang="fr">Modélisation des compétences, programmes pédagogiques, prérequis et parcours d&apos;apprentissage.</rdfs:comment>
        <rdfs:label xml:lang="fr">Ontologie Éducation et Formation</rdfs:label>
    </owl:Ontology>
    


