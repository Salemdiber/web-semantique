PORT=3000
NODE_ENV=development
SESSION_SECRET=remplacer-par-une-longue-cle-aleatoire
# Numéro WhatsApp de destination au format international, sans + ni espaces.
WHATSAPP_NUMBER=21655333100
# URL partenaire MyGo pour l’accès aux hôtels (remplacer par le lien conventionné si différent).
MYGO_HOTELS_URL=https://www.mygo.co/
# MongoDB Atlas (requis pour le serveur et le seed)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mercan_voyages
# Facultatif en local ; sur Vercel, connecter le store Blob au projet pour les uploads admin.
BLOB_READ_WRITE_TOKEN=
# MySQL source, utilisé uniquement pour la migration facultative
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mercan_voyages
DB_USER=root
DB_PASSWORD=
ADMIN_EMAIL=admin@mercanvoyages.tn
ADMIN_PASSWORD=ChangerCeMotDePasse123!
# URL publique du site, sans slash final (requise pour les liens de réinitialisation).
APP_URL=https://www.mercanvoyages.tn
# Gmail : utiliser un mot de passe d'application, jamais le mot de passe normal du compte.
MAIL_USER=
MAIL_APP_PASSWORD=
# Facultatif ; par défaut, l’adresse MAIL_USER est utilisée.
MAIL_FROM=
