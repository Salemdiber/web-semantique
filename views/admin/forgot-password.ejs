<%- include('../partials/head', { title, description }) %>
<%- include('../partials/header') %>
<section class="auth-section section">
  <div class="auth-card card border-0">
    <a class="auth-mark" href="/"><img src="/images/mercan.jpg" alt="Mercan Voyages" width="96" height="96"></a>
    <p class="eyebrow">Espace réservé</p>
    <h1>Mot de passe oublié</h1>
    <p>Saisissez l’adresse e-mail du compte administrateur. Si elle correspond, vous recevrez un lien valable 30 minutes.</p>
    <form class="js-form" action="/api/auth/forgot-password" method="post">
      <label class="field"><span>Adresse e-mail</span><input class="form-control" name="email" type="email" required autocomplete="username"></label>
      <button class="button button--blue button--wide" type="submit">Envoyer le lien</button>
      <p class="form-feedback" aria-live="polite"></p>
    </form>
    <p class="auth-switch"><a class="text-link" href="/admin">Retour à la connexion</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
