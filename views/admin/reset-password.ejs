<%- include('../partials/head', { title, description }) %>
<%- include('../partials/header') %>
<section class="auth-section section">
  <div class="auth-card card border-0">
    <a class="auth-mark" href="/"><img src="/images/mercan.jpg" alt="Mercan Voyages" width="96" height="96"></a>
    <p class="eyebrow">Espace réservé</p>
    <h1>Nouveau mot de passe</h1>
    <% if (token) { %>
      <p>Choisissez un nouveau mot de passe (12 caractères minimum).</p>
      <form class="js-form" action="/api/auth/reset-password" method="post">
        <input type="hidden" name="token" value="<%= token %>">
        <label class="field"><span>Nouveau mot de passe</span><input class="form-control" name="password" type="password" required minlength="12" maxlength="100" autocomplete="new-password"></label>
        <label class="field"><span>Confirmer le mot de passe</span><input class="form-control" name="confirmPassword" type="password" required minlength="12" maxlength="100" autocomplete="new-password"></label>
        <button class="button button--blue button--wide" type="submit">Modifier le mot de passe</button>
        <p class="form-feedback" aria-live="polite"></p>
      </form>
    <% } else { %>
      <p>Ce lien est invalide. Demandez un nouveau lien de réinitialisation.</p>
    <% } %>
    <p class="auth-switch"><a class="text-link" href="/admin">Retour à la connexion</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
