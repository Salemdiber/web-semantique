<%- include('../partials/head', { title, description }) %>
<%- include('../partials/header') %>
<section class="page-hero page-hero--travel">
  <div class="container">
    <p class="eyebrow eyebrow--light">Votre espace personnel</p>
    <h1>Paramètres du compte</h1>
    <p>Gérez vos informations personnelles et la sécurité de votre compte.</p>
  </div>
</section>
<section class="section container account-settings">
  <section class="account-settings__panel card border-0" aria-labelledby="account-profile-title">
    <p class="eyebrow">Vos informations</p>
    <h2 id="account-profile-title">Informations du compte</h2>
    <form class="js-form" action="/api/auth/account" method="post" data-method="PUT" data-keep-values>
      <label class="field"><span>Nom complet</span><input class="form-control" name="name" required minlength="2" maxlength="120" autocomplete="name" value="<%= user.name %>"></label>
      <label class="field"><span>Adresse e-mail</span><input class="form-control" name="email" type="email" required maxlength="190" autocomplete="email" value="<%= user.email %>"></label>
      <label class="field"><span>Téléphone</span><input class="form-control" name="phone" type="tel" pattern="[0-9+\\(\\).\\- ]{7,30}" maxlength="30" autocomplete="tel" value="<%= user.phone || '' %>"></label>
      <button class="button button--blue" type="submit">Enregistrer les informations</button>
      <p class="form-feedback" aria-live="polite"></p>
    </form>
  </section>
  <section class="account-settings__panel card border-0" aria-labelledby="account-password-title">
    <p class="eyebrow">Sécurité</p>
    <h2 id="account-password-title">Modifier le mot de passe</h2>
    <form class="js-form" action="/api/auth/change-password" method="post">
      <label class="field"><span>Mot de passe actuel</span><input class="form-control" name="currentPassword" type="password" required maxlength="100" autocomplete="current-password"></label>
      <label class="field"><span>Nouveau mot de passe</span><input class="form-control" name="password" type="password" required minlength="12" maxlength="100" autocomplete="new-password"></label>
      <label class="field"><span>Confirmer le nouveau mot de passe</span><input class="form-control" name="confirmPassword" type="password" required minlength="12" maxlength="100" autocomplete="new-password"></label>
      <button class="button button--blue" type="submit">Modifier le mot de passe</button>
      <p class="form-feedback" aria-live="polite"></p>
    </form>
  </section>
  <p><a class="text-link" href="<%= user.role === 'admin' ? '/admin' : '/mon-compte' %>">← Retour à <%= user.role === 'admin' ? 'l’administration' : 'mon compte' %></a></p>
</section>
<%- include('../partials/footer') %>
